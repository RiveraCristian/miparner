{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    // geojson: los tipos del mapa (MapLibre) declaran el espacio global GeoJSON.
    "types": ["geojson"]
  },
  "include": ["App.tsx", "src", "../shared"]
}
