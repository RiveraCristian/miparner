# ==========================================================================
# Rumbo — variables de entorno (ejemplo). Copiar a .env y completar.
# NUNCA versionar el .env real con secretos.
# ==========================================================================

# --- Base de datos (PostgreSQL + PostGIS, FUERA de Docker) ---
# Local (host nativo):
DATABASE_URL="postgresql://rumbo_user:CHANGE_ME@localhost:5432/rumbo?schema=public"
# Desde un contenedor apuntando al host:
#   postgresql://rumbo_user:CHANGE_ME@host.docker.internal:5432/rumbo?schema=public
# Producción (Cloud SQL por socket, password URL-encodeada):
#   postgresql://USER:PASS@localhost/BD?host=/cloudsql/PROYECTO:REGION:INSTANCIA

# --- Backend ---
NODE_ENV="development"
PORT="4000"
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- JWT ---
JWT_ACCESS_SECRET="CHANGE_ME_access_secret_rotable"
JWT_REFRESH_SECRET="CHANGE_ME_refresh_secret_rotable"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Twilio (OTP SMS/Voz — Módulo de Seguridad) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# OTP
OTP_TTL_MINUTES="5"
OTP_LENGTH="6"

# --- Google SSO (Fase 2, aún no activo) ---
GOOGLE_CLIENT_ID=""
GOOGLE_ALLOWED_DOMAIN=""
